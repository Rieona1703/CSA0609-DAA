
#include <stdio.h>

void selectionSort(int a[], int n) {
    int comparisons = 0, swaps = 0;
    for (int i = 0; i < n - 1; i++) {
        int min = i;
        for (int j = i + 1; j < n; j++) {
            comparisons++;
            if (a[j] < a[min])
                min = j;
        }
        if (min != i) {
            int t = a[i];
            a[i] = a[min];
            a[min] = t;
            swaps++;
        }
    }
    printf("Selection: Comparisons=%d Swaps=%d\n",
           comparisons, swaps);
}

void bubbleSort(int a[], int n) {
    int comparisons = 0, swaps = 0;
    for (int i = 0; i < n - 1; i++) {
        int changed = 0;
        for (int j = 0; j < n - i - 1; j++) {
            comparisons++;
            if (a[j] > a[j + 1]) {
                int t = a[j];
                a[j] = a[j + 1];
                a[j + 1] = t;
                swaps++;
                changed = 1;
            }
        }
        if (!changed) break;
    }
    printf("Bubble: Comparisons=%d Swaps=%d\n",
           comparisons, swaps);
}

void insertionSort(int a[], int n) {
    int comparisons = 0, shifts = 0;
    for (int i = 1; i < n; i++) {
        int key = a[i], j = i - 1;
        while (j >= 0) {
            comparisons++;
            if (a[j] <= key) break;
            a[j + 1] = a[j];
            shifts++;
            j--;
        }
        a[j + 1] = key;
    }
    printf("Insertion: Comparisons=%d Shifts=%d\n",
           comparisons, shifts);
}

int main() {
    int data[3][8] = {
        {10,20,30,40,50,60,70,80},
        {80,70,60,50,40,30,20,10},
        {10,20,30,50,40,60,70,80}
    };

    for (int k = 0; k < 3; k++) {
        int a[8], b[8], c[8];
        for (int i = 0; i < 8; i++)
            a[i] = b[i] = c[i] = data[k][i];

        printf("\nDataset %c\n", 'A' + k);
        selectionSort(a, 8);
        bubbleSort(b, 8);
        insertionSort(c, 8);
    }
    return 0;
}
