
#include <stdio.h>

void search(int a[], int n, int key) {
    int comparisons = 0;
    for (int i = 0; i < n; i++) {
        comparisons++;
        if (a[i] == key) {
            printf("Found at index %d, Comparisons = %d\n",
                   i, comparisons);
            return;
        }
    }
    printf("Not found, Comparisons = %d\n", comparisons);
}

int main() {
    int sizes[] = {10, 100, 1000};

    for (int k = 0; k < 3; k++) {
        int n = sizes[k];
        int a[1000];

        for (int i = 0; i < n; i++)
            a[i] = i + 1;

        printf("\nList size = %d\n", n);
        search(a, n, 1);
        search(a, n, n / 2);
        search(a, n, n);
        search(a, n, n + 1);
    }
    return 0;
}
